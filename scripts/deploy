#!/usr/bin/env bash
# Deploy origin/main to the NUC: stop the app, git pull, start serve.sh, wait for startup.
# Usage: scripts/deploy.sh [host]
#   env: DEPLOY_HOST, DEPLOY_PATH, DEPLOY_BRANCH, DEPLOY_STOP_TIMEOUT, DEPLOY_START_TIMEOUT
set -euo pipefail

HOST="${1:-${DEPLOY_HOST:-repeater-nuc}}"
REMOTE_PATH="${DEPLOY_PATH:-/home/rfreedman/projects/dvra-repeater-announcements}"
BRANCH="${DEPLOY_BRANCH:-main}"
stop_timeout="${DEPLOY_STOP_TIMEOUT:-30}"
start_timeout="${DEPLOY_START_TIMEOUT:-180}"
if [[ ! "$stop_timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid DEPLOY_STOP_TIMEOUT=$stop_timeout (positive integer seconds)." >&2
  exit 1
fi
if [[ ! "$start_timeout" =~ ^[1-9][0-9]*$ ]]; then
  echo "Invalid DEPLOY_START_TIMEOUT=$start_timeout (positive integer seconds)." >&2
  exit 1
fi

cd "$(dirname "$0")/.."

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Local working tree has uncommitted changes; commit and push first." >&2
  exit 1
fi
git fetch --quiet origin "$BRANCH"
if [[ -n "$(git rev-list "origin/$BRANCH..$BRANCH")" ]]; then
  echo "Local $BRANCH has commits not pushed to origin/$BRANCH; push first." >&2
  exit 1
fi

echo "Deploying origin/$BRANCH to $HOST:$REMOTE_PATH"
ssh "$HOST" bash -s -- "$REMOTE_PATH" "$BRANCH" "$stop_timeout" "$start_timeout" <<'REMOTE'
set -euo pipefail
cd "$1"
branch="$2"
stop_timeout="$3"
start_timeout="$4"
# Non-interactive ssh skips ~/.bashrc, where the uv installer adds itself; serve.sh needs uv to sync.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
pattern='python -m app serve'
out=data/logs/serve.out

if ! command -v uv >/dev/null 2>&1; then
  echo "uv not found on the NUC (serve.sh needs it to sync dependencies); app left running." >&2
  exit 1
fi
git fetch --quiet origin "$branch"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "NUC working tree has local changes; app left running." >&2
  git status --short --untracked-files=no >&2
  if [[ "$(git status --porcelain --untracked-files=no)" == " M uv.lock" ]]; then
    echo "If only uv.lock changed: git restore uv.lock on the NUC, then redeploy (see README Deploying)." >&2
  fi
  exit 1
fi
if ! git merge-base --is-ancestor HEAD "origin/$branch"; then
  echo "NUC HEAD cannot fast-forward to origin/$branch; app left running." >&2
  exit 1
fi

version_at() {
  git show "$1:pyproject.toml" | sed -n 's/^version *= *"\(.*\)"/\1/p' | head -n 1
}
deployed="$(version_at HEAD)"
candidate="$(version_at "origin/$branch")"
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$branch")" ]]; then
  newest="$(printf '%s\n%s\n' "$deployed" "$candidate" | sort -V | tail -n 1)"
  if [[ "$candidate" == "$deployed" || "$newest" != "$candidate" ]]; then
    echo "origin/$branch has new commits but version is $candidate (deployed: $deployed)." >&2
    echo "Bump it on the dev machine, then commit, push, and re-run scripts/deploy.sh:" >&2
    echo "  uv version --bump patch     # or minor / major" >&2
    echo "App left running; nothing deployed." >&2
    exit 1
  fi
  echo "Deploying version $deployed -> $candidate"
fi

pids="$(pgrep -u "$USER" -f "$pattern" || true)"
if [[ -n "$pids" ]]; then
  echo "Stopping app (pid $pids)"
  kill -TERM $pids
  for ((i = 0; i < stop_timeout; i++)); do
    pgrep -u "$USER" -f "$pattern" >/dev/null || break
    sleep 1
  done
  if pgrep -u "$USER" -f "$pattern" >/dev/null; then
    # No SIGKILL: a hard kill mid-transmission can leave PTT keyed.
    echo "App still running after ${stop_timeout}s (pid $(pgrep -u "$USER" -f "$pattern" | tr '\n' ' '))." >&2
    echo "Not updating. Check it and stop it yourself, then re-run the deploy." >&2
    exit 1
  fi
else
  echo "App was not running"
fi

old="$(git rev-parse --short HEAD)"
git merge --quiet --ff-only "origin/$branch"
new="$(git rev-parse --short HEAD)"
echo "Updated $old -> $new (version $(version_at HEAD))"
mkdir -p "$(dirname "$out")"
setsid nohup ./serve.sh >"$out" 2>&1 </dev/null &
pid=$!
echo "Starting app (output: $1/$out)"
serve_lines=0

for ((i = 0; i < start_timeout; i++)); do
  if [[ -f "$out" ]]; then
    total="$(wc -l <"$out" | tr -d ' ')"
    if (( total > serve_lines )); then
      tail -n +"$((serve_lines + 1))" "$out"
      serve_lines=$total
    fi
  fi
  if grep -q 'Startup complete' "$out" 2>/dev/null; then
    line="$(grep -m 1 'Startup complete' "$out")"
    if [[ "$line" == *"radio mode: stub"* ]]; then
      echo "WARNING: radio mode is stub; set TTS_RADIO_BACKEND=dra in .env for on-air playback." >&2
    fi
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "App exited during startup. Last output:" >&2
    tail -n 40 "$out" >&2
    exit 1
  fi
  sleep 1
done
echo "No 'Startup complete' after ${start_timeout}s. Last output:" >&2
tail -n 40 "$out" >&2
exit 1
REMOTE
