# Copy to .env.secrets and fill in real values.
# Never commit .env.secrets; do not include it in backups.
# Shared by ops scripts (R2 backup, Bird email, future cron jobs).

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Keep this many newest backups locally and in R2 (default 14).
R2_BACKUP_KEEP=14

# --- Bird email ---
BIRD_API_KEY=
BACKUP_NOTIFY_FROM=repeater@yourdomain.com
BACKUP_NOTIFY_FROM_NAME="Repeater Announcements"
BACKUP_NOTIFY_TO=recipient1@yourdomain.com,recipient2@anotherdomain.com
