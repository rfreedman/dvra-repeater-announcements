# Copy to .env and uncomment to enable. Real environment variables win over this file.

# --- Core / process ---
# TTS_HOST=0.0.0.0
# TTS_PORT=8000
# TTS_DATA_DIR=./data
# TTS_USERS_PATH=./data/users.json
# TTS_PCM_CACHE_DIR=./data/pcm
# TTS_LOG_DIR=./data/logs
# TTS_LOG_KEEP_DAYS=30
# TTS_VOICES_DIR=./voices
# TTS_PIPER_VOICES_FILE=./config/piper-voices.json
# TTS_DEFAULT_VOICE=en_US-ryan-medium
# TTS_PIPER_QUALITIES=all
# TTS_TIMEZONE=America/New_York
# TTS_MAX_TEXT_CHARS=5000
# TTS_SPEED=1.0
# TTS_SENTENCE_PAUSE=0.25
# TTS_PTT_LEAD_SECONDS=1
# TTS_BUSY_RETRY_SECONDS=5
# TTS_BUSY_GIVE_UP_SECONDS=45
# TTS_SLOT_HALF_WINDOW_MINUTES=10
# TTS_SLOT_LOOKAHEAD_HOURS=72
# TTS_SCHEDULER_MAX_WAIT_SECONDS=5

# Station identity (UI title, logo alt, macOS idle assertion name). Required.
STATION_CALL=N0CALL
STATION_NAME=Example Radio Club
# APP_TITLE=N0CALL Announcements

# Radio backend: stub (default, no hardware) or dra (CM119A / DRA-36M HID + USB audio).
# TTS_RADIO_BACKEND=stub
# TTS_RADIO_BACKEND=dra
# TTS_DRA_USB_CHANNEL=left
# TTS_DRA_COS_LINE=vol_dn
# TTS_DRA_COS_ACTIVE_HIGH=false
# If the app never shows idle / clear countdown, run:
#   python scripts/dra36m_check.py monitor --cos vol_dn
# and toggle TTS_DRA_COS_ACTIVE_HIGH if idle/busy labels are swapped.
# Optional: comma-separated PortAudio match substrings or device indices (one per DRA).
# When unset, all C-Media / USB PnP Sound Device outputs are used (paired with HID paths).
# Two DRAs on one NUC: leave TTS_DRA_HID_PATH unset; use fixed USB ports or set this if order is wrong.
# TTS_DRA_AUDIO_DEVICES=2,3
# Continuous COS idle required after synthesize, before PTT (bench voice-gate default: 10).
# TTS_DRA_CLEAR_SECONDS=10
# TTS_DRA_CLEAR_POLL_SECONDS=0.25
# TTS_DRA_FINAL_CHECK_SECONDS=1.0
# Background COS poll while the app runs (credits idle time before Trigger now). Default on.
# TTS_DRA_COS_TRACK=false
# Single DRA only (Mac dev or one radio on the NUC): pin one CM119 HID (hex from probe).
# Do not set when two DRAs are connected on the NUC — you need both CM119 HID interfaces.
# TTS_DRA_HID_PATH=
# Linux NUC: unmute CM119 ALSA Speaker at startup (default on). Set false to skip.
# TTS_DRA_ALSA_UNMUTE=true
# TTS_DRA_ALSA_SPEAKER_LEVEL=100%
# TTS_DRA_ALSA_PLAYBACK_DEVICE=
# Prefer ALSA (hw:…) PortAudio names over PipeWire USB sinks (default on).
# TTS_DRA_PREFER_ALSA_HW=true
# Linux playback backend: aplay (default) or portaudio.
# TTS_DRA_LINUX_PLAYBACK=aplay

# Dev only: Trigger now on each schedule row. Plays the announcement without
# changing Last or the next scheduled slot.
# TTS_TRIGGER_NOW=false

# Verbose INFO logs for busy / defer / clear-hold / manual trigger retries (app.fire.trace).
# TTS_FIRE_VERBOSE_LOG=false

# Optional. If unset, a secret is created at data/.session_secret on first run.
# TTS_SESSION_SECRET=change-me-to-a-long-random-string

# Log out after this many idle seconds (default 1800 = 30 minutes).
# Session cookies also have no Max-Age, so they are dropped when the browser session ends.
# TTS_SESSION_IDLE_SECONDS=1800

# Failed sign-ins per username from the same client before HTTP 429.
# In-memory only; counters reset when the process restarts.
# TTS_LOGIN_MAX_FAILURES=5
# TTS_LOGIN_WINDOW_SECONDS=300
